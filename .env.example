# Copy this file to .env for local development and replace placeholders locally.
# Never put real credentials or private keys in this file.

# Application
APP_ENV=development
APP_PORT=3000

# Add project-specific variables below with safe, non-secret example values.
# SERVICE_API_KEY=replace-me-locally

# Legacy direct PostgreSQL fallback; the MVP workflow uses Supabase Data API instead.
# MARKET_DB_URL=postgresql://user:password@host:5432/database

# Supabase Data API target for the password-free MVP path.
# SUPABASE_URL=https://your-project-ref.supabase.co
# SUPABASE_SECRET_KEY=sb_secret_replace-me
